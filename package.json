{
  "name": "nasdocker",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,ui -c blue,green \"npm:dev:server\" \"npm:dev:ui\"",
    "dev:ui": "vinext dev",
    "dev:server": "PORT=3001 tsx watch server/index.ts",
    "build": "npm run build:ui && npm run build:server",
    "build:ui": "vinext build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=cjs --outfile=dist/server/index.cjs",
    "start": "NODE_ENV=production node dist/server/index.cjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt"
  },
  "devDependencies": {
    "@base-ui/react": "1.7.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.35",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.2",
    "lucide-react": "1.31.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.2.1",
    "tsx": "^4.20.6",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.10",
    "vite": "8.3.0",
    "yaml": "^2.9.1"
  },
  "type": "module"
}
