# Web login
NASDOCKER_USERNAME=admin
NASDOCKER_PASSWORD=change-this-long-password
NASDOCKER_PORT=3080

# Host directory that contains one subdirectory per Compose project.
COMPOSE_HOST_DIR=/srv/compose

# Docker daemon configuration file on the Linux host. Change only for a custom dockerd setup.
HOST_DOCKER_CONFIG_PATH=/etc/docker/daemon.json

# Avoid pulling the same latest tag more often than this interval.
UPDATE_CACHE_MINUTES=10

# Maximum wait for one manifest request during a latest update check.
UPDATE_CHECK_TIMEOUT_SECONDS=30

# Maximum wait for Docker Engine to finish pulling an image during an upgrade.
UPDATE_PULL_TIMEOUT_SECONDS=900

# Maximum wait per request while benchmarking a registry mirror.
MIRROR_BENCHMARK_TIMEOUT_SECONDS=8

# Optional proxy used only by DockerManager when reading remote image manifests.
# It is never written to the Docker daemon configuration.
UPDATE_CHECK_PROXY=
UPDATE_CHECK_NO_PROXY=localhost,127.0.0.1
